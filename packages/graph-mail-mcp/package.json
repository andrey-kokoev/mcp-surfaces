{
  "name": "@narada-core/graph-mail-mcp",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "description": "Policy-gated Microsoft Graph mail MCP surface for live reads and draft management.",
  "bin": {
    "graph-mail-mcp": "./dist/src/main.js"
  },
  "types": "./dist/src/main.d.ts",
  "exports": {
    "./surface-definition": {
      "types": "./dist/src/surface-definition.d.ts",
      "default": "./dist/src/surface-definition.js"
    },
    ".": {
      "types": "./dist/src/main.d.ts",
      "default": "./dist/src/main.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "pnpm build && node --disable-warning=ExperimentalWarning dist/test/graph-mail-mcp.test.js && node --disable-warning=ExperimentalWarning dist/test/protocol-smoke.test.js",
    "test:e2e:external": "pnpm build && node --disable-warning=ExperimentalWarning dist/test/site-fabric-graph-mail-e2e.test.js"
  },
  "dependencies": {
    "@narada-core/mcp-fabric-contracts": "workspace:*",
    "@narada-core/mcp-telemetry": "workspace:*",
    "@narada-core/mcp-transport": "workspace:*",
    "@narada-core/sqlite": "workspace:*"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "devDependencies": {
    "@narada-core/mcp-e2e-harness": "workspace:*"
  }
}
