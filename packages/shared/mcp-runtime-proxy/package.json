{
  "name": "@narada2/mcp-runtime-proxy",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "pnpm --filter @narada2/mcp-e2e-harness build && pnpm build && node dist/test/mcp-runtime-proxy.test.js && node --test dist/test/carrier-generation.test.js && node --test dist/test/runtime-lifecycle.test.js"
  },
  "types": "./dist/src/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/main.d.ts",
      "default": "./dist/src/main.js"
    },
    "./carrier-generation": {
      "types": "./dist/src/carrier-generation.d.ts",
      "default": "./dist/src/carrier-generation.js"
    },
    "./carrier-materialization": {
      "types": "./dist/src/carrier-materialization.d.ts",
      "default": "./dist/src/carrier-materialization.js"
    },
    "./runtime-lifecycle": {
      "types": "./dist/src/runtime-lifecycle.d.ts",
      "default": "./dist/src/runtime-lifecycle.js"
    }
  },
  "dependencies": {
    "@narada2/artifact-integrity": "workspace:*",
    "@narada2/mcp-fabric-contracts": "workspace:*",
    "@narada2/process-launch-posture": "workspace:*"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "devDependencies": {
    "@narada2/mcp-e2e-harness": "workspace:*"
  },
  "narada": {
    "artifact": {
      "profile": "mcp-runtime-proxy-v3",
      "entrypoints": [
        "dist/src/main.js"
      ],
      "build_script": "build"
    }
  }
}
