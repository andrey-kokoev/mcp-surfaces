{
  "name": "@narada-core/sop-mcp",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "type": "module",
  "description": "Standard operating procedure MCP surface for versioned runbook templates and durable run execution.",
  "bin": {
    "sop-mcp": "./dist/src/main.js",
    "sop-action-dispatch": "./dist/src/action-dispatcher.js",
    "sop-handoff-consume": "./dist/src/handoff-consumer.js"
  },
  "types": "./dist/src/main.d.ts",
  "exports": {
    "./surface-definition": {
      "types": "./dist/src/surface-definition.d.ts",
      "default": "./dist/src/surface-definition.js"
    },
    "./action-dispatcher": {
      "types": "./dist/src/action-dispatcher.d.ts",
      "default": "./dist/src/action-dispatcher.js"
    },
    "./handoff-consumer": {
      "types": "./dist/src/handoff-consumer.d.ts",
      "default": "./dist/src/handoff-consumer.js"
    },
    ".": {
      "types": "./dist/src/main.d.ts",
      "default": "./dist/src/main.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "pnpm build && node --test dist/test/action-dispatcher.test.js dist/test/handoff-consumer.test.js && node dist/test/sop-mcp.test.js && node dist/test/durability.test.js && node dist/test/protocol-smoke.test.js && node --disable-warning=ExperimentalWarning dist/test/site-fabric-sop-e2e.test.js"
  },
  "dependencies": {
    "@narada-core/mcp-fabric-contracts": "workspace:*",
    "@narada-core/mcp-runtime-client": "workspace:*",
    "@narada-core/sqlite": "workspace:*",
    "ajv": "^8.20.0",
    "js-yaml": "^4.2.0"
  },
  "files": [
    "dist/",
    "sops/"
  ],
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@narada-core/mcp-e2e-harness": "workspace:*",
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3"
  }
}
