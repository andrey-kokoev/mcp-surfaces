{
  "name": "@narada-core/speech-mcp",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "description": "Policy-gated speech MCP surface with SAPI/OpenAI TTS and bounded microphone capture transcription.",
  "bin": {
    "speech-mcp": "./dist/src/main.js"
  },
  "types": "./dist/src/main.d.ts",
  "exports": {
    "./surface-definition": {
      "types": "./dist/src/surface-definition.d.ts",
      "default": "./dist/src/surface-definition.js"
    },
    ".": {
      "types": "./dist/src/main.d.ts",
      "default": "./dist/src/main.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "pnpm run test:bun",
    "test:bun": "pnpm build && bun dist/test/protocol-smoke.test.js && bun dist/test/speech-mcp.test.js",
    "test:node": "pnpm build && node dist/test/protocol-smoke.test.js && node dist/test/speech-mcp.test.js",
    "test:e2e:external": "pnpm build && node dist/test/site-fabric-speech-e2e.test.js"
  },
  "dependencies": {
    "@narada-core/mcp-fabric-contracts": "workspace:*",
    "@narada-core/provider-registry": "workspace:*"
  },
  "devDependencies": {
    "@narada-core/mcp-e2e-harness": "workspace:*",
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3"
  },
  "files": [
    "dist/",
    "config/"
  ]
}
